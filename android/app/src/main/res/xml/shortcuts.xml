<?xml version="1.0" encoding="utf-8"?>
<!-- Lets your devices (published as dynamic shortcuts) appear in the share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.theformofvoid.voidbridge.SendFileActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.theformofvoid.voidbridge.category.SEND_TO_DEVICE" />
    </share-target>
</shortcuts>
